#include <stdio.h>
int main()
{
 char cipher[500];
 char english[] = "ETAOINSHRDLCUMWFGYPBVKJXQZ";
 char result[500];
 int count[26] = {0};
 int order[26];
 int i, j, temp;
 printf("Enter ciphertext: ");
 scanf(" %[^\n]", cipher);
 for(i = 0; cipher[i] != '\0'; i++)
 {
 if(cipher[i] >= 'A' && cipher[i] <= 'Z')
 count[cipher[i] - 'A']++;
 }
 for(i = 0; i < 26; i++)
 order[i] = i;
 for(i = 0; i < 26; i++)
 {
 for(j = i + 1; j < 26; j++)
 {
 if(count[order[i]] < count[order[j]])
 {
 temp = order[i];
 order[i] = order[j];
 order[j] = temp;
 }
}
 }
 for(i = 0; cipher[i] != '\0'; i++)
 {
 if(cipher[i] >= 'A' && cipher[i] <= 'Z')
 {
 for(j = 0; j < 26; j++)
 {
 if(order[j] == cipher[i] - 'A')
 break;
 }
 result[i] = english[j];
 }
 else
 {
 result[i] = cipher[i];
 }
 }
 result[i] = '\0';
 printf("\nFrequency based possible plaintext:\n");
 printf("%s\n", result);
 printf("\nTop possible plaintexts can be generated by trying different\n");
 printf("frequency mappings and ranking them using English statistics.\n");
 return 0;
}
