#include <stdio.h>
#include <string.h>
int
P10[]={3,5,2,7,4,10,1,9,8,6},P8[]={6,3,7,4,8,5,10,9},IP[]={2,6,3,1,4,8,5,7},IP1[]={4,1,3,5,7,2,8,6},EP[]={
4,1,2,3,2,3,4,1},P4[]={2,4,3,1};
int S0[4][4]={{1,0,3,2},{3,2,1,0},{0,2,1,3},{3,1,3,2}},S1[4][4]={{0,1,2,3},{2,0,1,3},{3,0,1,0},{2,1,0,3}};
void perm(int*a,int*b,int*p,int n)
{
 int i;
 for(i=0;i<n;i++) b[i]=a[p[i]-1];
}
void ls(int*a)
{
 int t=a[0],i;
 for(i=0;i<4;i++) a[i]=a[i+1];
 a[4]=t;
}
void keys(char*k,int K[2][8])
{
 int a[10],b[10],i;
 for(i=0;i<10;i++) a[i]=k[i]-'0';
erm(a,b,P10,10);
 ls(b);
 ls(b+5);
 perm(b,K[0],P8,8);
 ls(b);
 ls(b);
 ls(b+5);
 ls(b+5);
 perm(b,K[1],P8,8);
}
void fk(int*x,int*k)
{
 int e[8],z[4],r[4],i,row,col,v;
 perm(x+4,e,EP,8);
 for(i=0;i<8;i++) e[i]^=k[i];
 row=e[0]*2+e[3];
 col=e[1]*2+e[2];
 v=S0[row][col];
 z[0]=v/2;
 z[1]=v%2;
 row=e[4]*2+e[7];
 col=e[5]*2+e[6];
 v=S1[row][col];
z[2]=v/2;
 z[3]=v%2;
 for(i=0;i<4;i++) r[i]=z[P4[i]-1];
 for(i=0;i<4;i++) x[i]^=r[i];
}
void crypt(char*in,char*out,int K[2][8])
{
 int a[8],b[8],i,t;
 for(i=0;i<8;i++) a[i]=in[i]-'0';
 perm(a,b,IP,8);
 fk(b,K[0]);
 for(i=0;i<4;i++)
 {
 t=b[i];
 b[i]=b[i+4];
 b[i+4]=t;
 }
 fk(b,K[1]);
 perm(b,a,IP1,8);
 for(i=0;i<8;i++) out[i]=a[i]+'0';
 out[8]=0;
}
int main()
{
 char key[11],ctr[9],plain[200],ks[9],out[200];
 int K[2][8],i,j,L,n;
 printf("Enter 10-bit key: ");
scanf("%10s",key);
 printf("Enter 8-bit starting counter: ");
 scanf("%8s",ctr);
 printf("Enter plaintext bits (multiple of 8): ");
 scanf("%199s",plain);
 L=strlen(plain);
 if(L%8)
 {
 printf("Length must be multiple of 8.\n");
 return 0;
 }
 keys(key,K);
 for(i=0;i<L;i+=8)
 {
 crypt(ctr,ks,K);
 for(j=0;j<8;j++) out[i+j]=((plain[i+j]-'0')^(ks[j]-'0'))+'0';
 for(n=7;n>=0;n--)
 {
 if(ctr[n]=='0')
 {
ctr[n]='1';
 break;
 }
 ctr[n]='0';
 }
 }
 out[L]=0;
 printf("Ciphertext: %s\n",out);
 printf("Decrypt by running again with ciphertext as plaintext and same key/counter.\n");
 return 0;
}
