#include <stdio.h>
#include <string.h>
int main()
{
 char cipher[500];
 char freq[] = "ETAOINSHRDLCUMWFGYPBVKJXQZ";
 char map[26];
 int count[26] = {0};
 int order[26];
 int i, j, temp, n, top;
 printf("Enter ciphertext: ");
 scanf(" %[^\n]", cipher);
 printf("Enter number of possible plaintexts: ");
 scanf("%d", &top);
 for(i = 0; i < 26; i++)
 {
 order[i] = i;
 }
 for(i = 0; cipher[i] != '\0'; i++)
 {
if(cipher[i] >= 'A' && cipher[i] <= 'Z')
 count[cipher[i] - 'A']++;
 }
 for(i = 0; i < 26; i++)
 {
 for(j = i + 1; j < 26; j++)
 {
 if(count[order[i]] < count[order[j]])
 {
 temp = order[i];
 order[i] = order[j];
 order[j] = temp;
 }
 }
 }
 printf("\nPossible plaintexts:\n");
 if(top > 10)
 top = 10;
for(n = 0; n < top; n++)
 {
 for(i = 0; i < 26; i++)
 map[i] = freq[(i + n) % 26];
 printf("%d. ", n + 1);
 for(i = 0; cipher[i] != '\0'; i++)
 {
 if(cipher[i] >= 'A' && cipher[i] <= 'Z')
 {
 for(j = 0; j < 26; j++)
 {
 if(order[j] == cipher[i] - 'A')
 break;
 }
 printf("%c", map[(j + n) % 26]);
 }
 else
 {
 printf("%c", cipher[i]);
 }
 }
 printf("\n");
 }
return 0;
}


