#include <stdio.h>
#include <string.h>
int main()
{
 char pt[100];
 int key[100],i,n;
 printf("Enter Plaintext (without spaces): ");
 scanf("%s",pt);
 n=strlen(pt);
 printf("Enter %d key values:\n",n);
 for(i=0;i<n;i++)
 scanf("%d",&key[i]);
 printf("\nCipher Text: ");
 for(i=0;i<n;i++)
 {
 int c=((pt[i]-'a')+key[i])%26;
 printf("%c",c+'A');
 }
 return 0;
}
