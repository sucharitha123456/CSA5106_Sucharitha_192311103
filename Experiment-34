#include <stdio.h>
#include <string.h>
void xorb(unsigned char*a,unsigned char*b,unsigned char*out,int n)
{
 int i;
 for(i=0;i<n;i++)
 out[i]=a[i]^b[i];
}
void enc(unsigned char*b,unsigned char*k,int n)
{
 int i;
 for(i=0;i<n;i++)
 b[i]^=k[i];
}
void show(char*s,unsigned char*b,int n)
{
 int i;
 printf("%s: ",s);
 for(i=0;i<n;i++)
 printf("%02X ",b[i]);
 printf("\n");
}
int main()
{
 unsigned char p[64],key[10],iv[10],c[64],d[64],tmp[8],prev[8];
 int len,pad,i,j;
 printf("Plaintext (max 55 chars): ");
 fgets((char*)p,56,stdin);
 len=(int)strlen((char*)p);
 if(len>0&&p[len-1]=='\n')
 p[--len]=0;
 printf("8-char key: ");
 fgets((char*)key,10,stdin);
 printf("8-char IV: ");
 fgets((char*)iv,10,stdin);
 key[strcspn((char*)key,"\n")]=0;
 iv[strcspn((char*)iv,"\n")]=0;
 pad=8-len%8;
 if(pad==0)
 pad=8;
 p[len]=1;
 for(i=len+1;i<len+pad;i++)
p[i]=0;
 len+=pad;
 printf("\nECB\n");
 for(i=0;i<len;i+=8)
 {
 for(j=0;j<8;j++)
 c[i+j]=p[i+j];
 enc(c+i,key,8);
 }
 show("Cipher",c,len);
 for(i=0;i<len;i+=8)
 {
 for(j=0;j<8;j++)
 d[i+j]=c[i+j];
 enc(d+i,key,8);
 }
 show("Decrypted",d,len);
 printf("\nCBC\n");
 for(j=0;j<8;j++)
 prev[j]=iv[j];
 for(i=0;i<len;i+=8)
 {
 xorb(p+i,prev,tmp,8);
 enc(tmp,key,8);
 for(j=0;j<8;j++)
 {
c[i+j]=tmp[j];
 prev[j]=tmp[j];
 }
 }
 show("Cipher",c,len);
 for(j=0;j<8;j++)
 prev[j]=iv[j];
 for(i=0;i<len;i+=8)
 {
 for(j=0;j<8;j++)
 tmp[j]=c[i+j];
 enc(tmp,key,8);
 xorb(tmp,prev,d+i,8);
 for(j=0;j<8;j++)
 prev[j]=c[i+j];
 }
 show("Decrypted",d,len);
 printf("\nCFB\n");
 for(j=0;j<8;j++)
 prev[j]=iv[j];
 for(i=0;i<len;i+=8)
 {
 enc(prev,key,8);
 for(j=0;j<8;j++)
 {
 c[i+j]=p[i+j]^prev[j];
 prev[j]=c[i+j];
}
 }
 show("Cipher",c,len);
 for(j=0;j<8;j++)
 prev[j]=iv[j];
 for(i=0;i<len;i+=8)
 {
 enc(prev,key,8);
 for(j=0;j<8;j++)
 {
 d[i+j]=c[i+j]^prev[j];
 prev[j]=c[i+j];
 }
 }
 show("Decrypted",d,len);
 printf("Padding added: %d byte(s)\n",pad);
 return 0;
}
